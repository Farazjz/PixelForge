{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelForge AI",
  "version": "1.0.0",
  "identifier": "com.farazjz.pixelforge",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.cjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PixelForge AI — Pixel Art Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "shortDescription": "Pixel art studio",
    "longDescription": "A professional pixel-art creation studio that combines a powerful manual pixel editor with optional, provider-independent AI generation and editing.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
